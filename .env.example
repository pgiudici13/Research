# Deep Research — variabili d'ambiente
# SOLO placeholder: mai valori reali in questo file.
# Copiare in `.env` locale (non tracciato) o impostare nei secret settings Vercel.

# --- NVIDIA API (server-only) ---
# Se assenti, i moduli LLM risultano "unconfigured" e la ricerca degrada
# con fallback deterministici (nessun crash).
NVIDIA_API_KEY=
# Default in codice se vuoto: https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=
# Modello OpenAI-compatible da usare per /chat/completions.
NVIDIA_MODEL=

# --- SearXNG (server-only) ---
# Base URL = hostname HTTPS del Cloudflare Tunnel verso il Pi.
SEARXNG_BASE_URL=
# Token condiviso Vercel -> Pi (deve combaciare con la config del Pi, Step 30).
RESEARCH_INTERNAL_AUTH_TOKEN=
# Hostname pubblico del tunnel (NON segreto). Il token del tunnel non va qui.
CLOUDFLARE_TUNNEL_HOSTNAME=

# --- Budget di ricerca ---
# Default in codice se vuoti (range validi): 
#   RESEARCH_MAX_QUERIES      default 20      (1..100)
#   RESEARCH_MAX_SOURCES      default 8       (1..50)
#   RESEARCH_MAX_DEPTH        default 2       (1..5)
#   RESEARCH_TIMEOUT_MS       default 50000   (5000..600000)
#   RESEARCH_MAX_FETCH_BYTES  default 300000  (1000..10000000)
RESEARCH_MAX_QUERIES=
RESEARCH_MAX_SOURCES=
RESEARCH_MAX_DEPTH=
RESEARCH_TIMEOUT_MS=
RESEARCH_MAX_FETCH_BYTES=

# --- Operativa (opzionale) ---
# Livello di log: debug | info | warn | error (default: info)
LOG_LEVEL=
