# SearXNG settings — ESEMPIO senza segreti (copiare sul Pi come
# /home/admin/deep-research/searxng/settings.yml e sostituire
# __SEARXNG_SECRET_KEY__ con: openssl rand -hex 32)
use_default_settings: true

server:
  secret_key: "__SEARXNG_SECRET_KEY__" # placeholder: generare sul Pi
  bind_address: "127.0.0.1"
  port: 8080
  limiter: true
  public_instance: false
  image_proxy: false
  default_locale: "it"

ui:
  static_use_hash: true
  default_locale: "it"
  theme: simple

search:
  formats:
    - html
    - json        # JSON obbligatorio per l'API Deep Research
  safe_search: 0
  autocomplete: ""

outgoing:
  request_timeout: 6.0
  max_request_timeout: 10.0
  pool_connections: 10
  pool_maxsize: 10

engines:
  # Pi 3B da 1 GB RAM: pochi engine affidabili; timeout bassi.
  # Con use_default_settings i blocchi sono merge per nome engine.
  - name: google
    disabled: true
  - name: google images
    disabled: true
  - name: bing
    disabled: true
  - name: bing images
    disabled: true
  - name: brave
    disabled: true
  - name: brave.images
    disabled: true
  - name: startpage
    disabled: true
  - name: yahoo
    disabled: true
  - name: qwant
    disabled: true
  - name: wikipedia
    timeout: 4.0
  - name: duckduckgo
    timeout: 6.0
  - name: mojeek
    timeout: 6.0
